# Node.js 24.x is required. All paths are relative to this project.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
APP_ORIGIN=http://localhost:3001
# Set true behind HTTPS; keep false for http://localhost.
COOKIE_SECURE=false
# Set to 1 ONLY when behind one trusted reverse proxy.
TRUST_PROXY=0
MAX_UPLOAD_MB=20
# Optional ICE configuration for calls across restrictive networks.
# Use your own short-lived TURN credentials for a public deployment.
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
